# ──────────────────────────────────────────────
# Variáveis de Ambiente — Sistema Odontológico
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env com valores reais no git
# ──────────────────────────────────────────────

# Django
SECRET_KEY=django-insecure-mude-esta-chave-em-producao-use-uma-aleatoria-longa
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados (SQLite padrão para desenvolvimento)
# Para PostgreSQL em produção, use:
# DATABASE_URL=postgres://usuario:senha@localhost:5432/consultorio_db

# Tempo de vida dos tokens JWT (em segundos)
ACCESS_TOKEN_LIFETIME_HOURS=8
REFRESH_TOKEN_LIFETIME_DAYS=7
